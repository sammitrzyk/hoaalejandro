# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Resend API key (https://resend.com → API Keys). Server-side only.
RESEND_API_KEY=

# Where new leads + private feedback are emailed. Comma-separate for several.
LEAD_TO_EMAIL=

# Sender address on a domain you've verified in Resend, e.g.
# "Alejandro's Website <leads@yourdomain.com>"
FROM_EMAIL=

# Optional: also send every submission to a webhook (Google Sheets via Apps Script,
# Zapier, Make, a CRM) so you keep a record beyond email.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
